# Text-to-3D provider configuration. Values are read only by FastAPI.
# Use a compatible provider that accepts the contract described in
# TEXT3D_PROVIDER.md. No provider is hard-coded by DepthWizard.
TEXT3D_PROVIDER=generic_http
TEXT3D_API_URL=
TEXT3D_API_KEY=

# Required only when the provider returns a queued job without status_url.
# Example: https://provider.example/v1/jobs/{job_id}
TEXT3D_STATUS_URL_TEMPLATE=
TEXT3D_TIMEOUT_SECONDS=600
TEXT3D_POLL_SECONDS=4
