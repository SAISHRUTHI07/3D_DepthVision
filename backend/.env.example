# Text-to-3D provider configuration. Values are read only by FastAPI.
# Real Tripo Text-to-3D provider (default supported integration).
TEXT3D_PROVIDER=tripo
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://openapi.tripo3d.ai/v3
# Change only when selecting an available Tripo Text-to-Model version.
TRIPO_MODEL_VERSION=v3.1-20260211
TRIPO_TIMEOUT_SECONDS=900
TRIPO_POLL_SECONDS=3

# Optional generic provider adapter. Use only with a provider that follows
# TEXT3D_PROVIDER.md's generic JSON contract.
TEXT3D_API_URL=
TEXT3D_API_KEY=

# Required only when the provider returns a queued job without status_url.
# Example: https://provider.example/v1/jobs/{job_id}
TEXT3D_STATUS_URL_TEMPLATE=
TEXT3D_TIMEOUT_SECONDS=600
TEXT3D_POLL_SECONDS=4
